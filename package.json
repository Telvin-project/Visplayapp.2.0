{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "tsx server.ts",
    "test:identity": "node --test tests/identity-security.test.mjs tests/auth-http-security.test.mjs",
    "test:media": "node --test tests/media-access.test.mjs tests/media-http-security.test.mjs",
    "test:uploads": "node --import tsx --test tests/upload-security.test.mjs tests/upload-http-security.test.mjs",
    "test:finance": "node --import tsx --test tests/finance-security.test.mjs tests/finance-http-security.test.mjs",
    "test:ux": "node --import tsx --test tests/reader-ux-security.test.mjs",
    "test:mobile": "node --test mobile/tests/*.test.mjs",
    "test:safety": "node --import tsx --test tests/safety-security.test.mjs tests/safety-http-security.test.mjs tests/safety-authenticated-http.test.mjs",
    "test:ops": "node --import tsx --test tests/ops-config-security.test.mjs tests/ops-reconciliation-security.test.mjs tests/state-cas-security.test.mjs tests/http-safe.test.mjs",
    "test:all": "npm run lint && npm run test:identity && npm run test:media && npm run test:uploads && npm run test:finance && npm run test:ux && npm run test:mobile && npm run test:safety && npm run test:ops && npm run build",
    "ops:preflight": "node --import tsx scripts/ops-preflight.ts",
    "ops:reconcile": "node --import tsx scripts/ops-reconcile-evidence.ts",
    "finance:audit": "node --import tsx scripts/audit-legacy-finance.ts",
    "media:preview": "node --import tsx scripts/generate-preview.ts",
    "media:migrate": "node --import tsx scripts/migrate-legacy-video.ts",
    "media:cleanup": "node --import tsx scripts/cleanup-media-uploads.ts",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.800.0",
    "@aws-sdk/s3-request-presigner": "^3.800.0",
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "^0.35.5",
    "uuid": "^14.0.3",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
