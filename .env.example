# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE INTEGRATION:
# Required for live Supabase Auth (including Google Sign-In via Supabase OAuth),
# PostgreSQL database, and Row Level Security.
# Find these in your Supabase Dashboard -> Project Settings -> API.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# SERVER ONLY: never prefix secrets with VITE_ and never bundle them in the app.
# These values must point to the SAME Supabase project as the frontend values.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="set-in-server-secret-manager-only"
JWT_SECRET="set-a-unique-long-random-secret-in-server-secret-manager"

# SECTION H: Use 'local', 'staging', or 'production'. For deployed staging or
# production set NODE_ENV=production to serve built files with API hardening.
# Staging accepts only Paystack sk_test_ credentials; production accepts only
# sk_live_. Keep projects, buckets, tokens, domains and bank accounts separate.
VISPLAY_DEPLOYMENT_STAGE="local"

# SECTION D: Web-origin verification for all cookie-authenticated state changes.
# Every production web origin must be explicitly approved; comma-separated.
TRUSTED_WEB_ORIGINS="https://watch.your-domain.example"

# PAYSTACK (server-only): no Paystack secret is bundled into the frontend.
# The checkout URL is a full HTTPS URL on the SAME site as VisPlay's webapp.
# Configure the live Paystack account webhook to POST /api/paystack/webhook.
PAYSTACK_SECRET_KEY="sk_test_replace-with-secure-server-side-key"
PAYSTACK_CALLBACK_URL="https://watch.your-domain.example/"

# SECTION D: Apply migrations/20261107_visplay_financial_core.sql, reconcile
# ALL real balances, existing purchases, creator earnings and prior payouts,
# import the reviewed data in one DB transaction and verify conservation.
# A second operator then sets visplay_finance_control.migration_approved=true
# plus a nonempty approval_reference. The default false BLOCKS production startup
# and all financial RPC mutations. NEVER approve a dataset containing demo money.

# CLOUDFLARE R2: public assets and premium video MUST be separate buckets.
# The video bucket must have no public custom domain or r2.dev access.
# Only the server / dedicated preview worker should hold read credentials.
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="set-in-server-secret-manager"
R2_SECRET_ACCESS_KEY="set-in-server-secret-manager"
R2_BUCKET_NAME="visplay-public-assets"
R2_PUBLIC_BASE_URL="https://assets.your-domain.example"
R2_PRIVATE_VIDEO_BUCKET="visplay-private-videos"

# SECTION C: Apply migrations/20261107_visplay_upload_sessions.sql before enabling
# creator uploads in production. The server-only upload-session service fails
# closed if the table/RPC is missing. Never expose it via a browser Supabase key.
# Configure private R2 object lifecycle: delete staging/ objects after 2 days,
# abort unfinished multipart uploads after 1 day (in addition to operator cleanup).
# Restrict browser CORS on the PRIVATE bucket to your production web origins
# and PUT/HEAD with Content-Type and Content-Length; expose ETag for parts.
# Public bucket CORS is no longer needed for creator uploads.

# Preview worker security: set a separately managed antivirus command and
# update its signature database regularly (e.g. installed ClamAV 'clamscan').
# NODE_ENV=production causes preview generation to FAIL CLOSED if absent.
# Sandbox the worker: no inbound network, read-only root, restricted egress
# only to private R2/Supabase, hard CPU/RAM/disk/time limits.
MEDIA_MALWARE_SCANNER="clamscan"

# SECTION G: Public human-support mailboxes, NOT API secrets. These must be
# real, monitored addresses approved by the employer and legal/privacy owner.
# Leave blank until verified; the Safety Center will show an explicit blocker.
VISPLAY_SUPPORT_EMAIL=""
VISPLAY_COPYRIGHT_EMAIL=""
VISPLAY_PRIVACY_EMAIL=""

# Mandatory pre-launch Section G/H qualification:
# Publish reviewed Terms, Privacy, Community Rules, copyright/takedown,
# refund/removal remedy and retention policies; staff safety-case escalation.
# Move JSON-backed moderation cases/blocks to normalized transactional SQL.
# Do not enable uncontrolled livestreams or adult content without approved
# age assurance, rights checks and live moderation infrastructure.

# Operator-only cleanup (never enable by default):
# MEDIA_CLEANUP_APPROVED=yes npm run media:cleanup -- --apply

# Required operator setting in Supabase Auth -> Providers -> Email:
# Enable Confirm email. Configure production SMTP and site URL/redirect URLs.
# The application rejects new sign-up sessions when confirmation is disabled.
